#!/bin/bash
# collector — scans directories, reads readable files, skips bad ones safely

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

candidates=(
    "$SCRIPT_DIR/data1/file1.txt"
    "$SCRIPT_DIR/data2/file2.txt"
    "$SCRIPT_DIR/data3/file3.txt"
    "$SCRIPT_DIR/data1/does_not_exist.txt"
)

report="$SCRIPT_DIR/collector_report.txt"
> "$report"

echo "=== Collector Report — $(date) ===" >> "$report"

for f in "${candidates[@]}"; do
    if [ ! -e "$f" ]; then
        echo "[SKIP] $f - does not exist" >> "$report"
        continue
    fi
    if [ ! -r "$f" ]; then
        echo "[SKIP] $f - not readable" >> "$report"
        continue
    fi
    echo "[OK] $f -----------------" >> "$report"
    cat "$f" >> "$report"
    echo >> "$report"
done

echo "Collector finished. Report saved to $report"
