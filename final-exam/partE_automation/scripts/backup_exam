#!/bin/bash
# backup_exam — tars the entire final-exam folder to ~/exam-backups/

EXAM_DIR="/home/se-rasmey-rithysak/OS-SE--p20240043-/final-exam"
BACKUP_DIR="/home/se-rasmey-rithysak/exam-backups"

mkdir -p "$BACKUP_DIR"

timestamp=$(date '+%Y%m%d-%H%M%S')
archive_name="final-exam-$timestamp.tar.gz"

tar -czf "$BACKUP_DIR/$archive_name" --ignore-failed-read -C "/home/se-rasmey-rithysak/OS-SE--p20240043-" final-exam

echo "$(date '+%Y-%m-%d %H:%M:%S') | created $archive_name" >> "$BACKUP_DIR/backup_exam.log"
echo "Backup complete: $archive_name"
